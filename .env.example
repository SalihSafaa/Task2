# Copy this file to .env and fill in real values. Never commit .env.

# SQL Server 'sa' password: 8+ characters with upper, lower, digit and symbol
DB_PASSWORD=ChangeMe_Str0ng!

# JWT signing key: at least 32 characters
JWT_KEY=replace-with-a-long-random-string-of-32-or-more-characters

# First admin account, created at startup if no admin exists
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=ChangeMe_Admin1!

# Optional (defaults to Development)
ASPNETCORE_ENVIRONMENT=Development
APP_DB_PASSWORD=ChangeMe_AppDb1!